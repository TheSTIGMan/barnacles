# OPENROUTER_API_KEY: Required for OpenRouter LLM requests.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Optional. Selects which OpenRouter model to use for AI summaries.
# Defaults to openrouter/free if unset. Must be one of the approved models below:
#   google/gemma-4-26b-a4b-it:free
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3-super-120b-a12b:free
#   openai/gpt-oss-120b:free
#   meta-llama/llama-3.3-70b-instruct:free
#   deepseek/deepseek-v4-flash:free
#   qwen/qwen3-next-80b-a3b-instruct:free
#   openrouter/free  (default — routes to whichever free model is currently best)
OPENROUTER_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional public GitHub raw API key.
# Providing a personal access token boosts GitHub API rate limits from 60/hr to 5000/hr.
GITHUB_TOKEN=""

# HOST: Network interface the server binds to.
# Set to 127.0.0.1 to restrict to localhost in local development. Defaults to 0.0.0.0.
HOST=""

# SAVE_TEST_RESULTS: Set to 'true' to save scan results to disk in test-results/ for offline review.
# Only active when NODE_ENV is not 'production'. Off by default.
SAVE_TEST_RESULTS=""
